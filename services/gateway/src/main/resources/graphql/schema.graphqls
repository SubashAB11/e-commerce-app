scalar DateTime
scalar BigDecimal

type Query {
    customer(id: String!): Customer
    product(id: Int!): Product
}

type Customer {
    id: String!
    firstName: String
    lastName: String
    email: String
    address: Address
}

type Address {
    street: String
    houseNumber: String
    zipCode: String
}

type Product {
    id: Int!
    name: String
    description: String
    availableQuantity: Float
    price: BigDecimal
    categoryId: Int
    categoryName: String
    categoryDescription: String
}

type Order {
    id: Int!
    reference: String
    totalAmount: BigDecimal
    paymentMethod: PaymentMethod
    customer: Customer
    orderLines: [OrderLine]
    createdDate: DateTime
    lastModifiedDate: DateTime
}

type OrderLine {
    id: Int!
    order: Order
    product: Product
    quantity: Float
}

enum PaymentMethod {
    UPI
    CREDIT_CARD
    MASTER_CARD
    BITCOIN
}

type Payment {
    id: Int!
    amount: BigDecimal
    paymentMethod: PaymentMethod
    order: Order
    createdDate: DateTime
    lastModifiedDate: DateTime
}

type ProductsByCategory {
    id: Int!
    name: String
    description: String
    products: [Product]
}